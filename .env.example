# 本文件只声明可公开的运行配置，不要在这里填写任何密钥。
CANVAS_REGISTRATION_ENABLED=false
# 默认拒绝后端访问本机和私网；可信私网或 HTTP 服务按主机精确放行，不要填写协议、端口或路径。
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
# 多个主机使用英文逗号分隔，例如：gateway.internal,192.168.1.10
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
# “允许本机渠道”是独立的桌面部署能力，默认关闭；只有后端实际绑定 127.0.0.1 时 true 才会生效。
CANVAS_DESKTOP_LOCAL_CHANNELS_ENABLED=false
# 桌面本机渠道启用时必须显式使用：CANVAS_BACKEND_ADDR=127.0.0.1:8080
# 经内置 Web 代理访问时可留空，按请求 Host/转发 Host（含端口）检查来源。
# 独立跨域前端必须填写准确 Origin；不要使用 *，也不要公开 backend 端口。
CANVAS_CORS_ORIGINS=
# 启用服务商插件系统以支持特定服务的模型发现（如阿里云百炼的视频生成模型）
# 设置为 true 启用插件机制，false 使用传统方式（默认：false）
ENABLE_PROVIDER_PLUGINS=false
CANVAS_DATA_PATH=./data
# 本机开发缓存目录。Windows 建议改为 D:/open-ai-canvas-cache；Linux/macOS 可使用 ./.local/cache。
CANVAS_PROJECT_CACHE_DIR=./.local/cache
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
# 收到 SIGTERM 后等待活动后台任务完成的最长时间；生产 Compose 的 stop_grace_period 使用同一值。
CANVAS_SHUTDOWN_TIMEOUT=10m
# 开发和旧部署默认由后端启动时迁移；受管生产部署由独立 migrate 服务执行并将此项设为 false。
CANVAS_AUTO_MIGRATE=true
# 1Panel 可把运行配置直接写进编排，不需要预先创建本文件。
# Host Updater 安装脚本自动挂载 Socket；Token 仅新建在运行目录及 root-only systemd 配置。
CANVAS_UPDATER_TOKEN=
CANVAS_UPDATER_SOCKET_DIR=/run/open-ai-canvas-updater
CANVAS_UPDATER_TOKEN_FILE=/run/open-ai-canvas-updater/token
CANVAS_UPDATER_REPOSITORY=buttonslaybaugh397-art/open-ai-canvas
# 1Panel 定制编排使用 docker-compose.1panel.yml；标准部署保持 docker-compose.deploy.yml。
CANVAS_UPDATER_COMPOSE_FILE=docker-compose.deploy.yml
# 1Panel 本地文件可叫 docker-compose.yml；远端更新须使用对应的生产编排。
CANVAS_UPDATER_RELEASE_COMPOSE_FILE=docker-compose.deploy.yml
# 安装时可选：单独选择更新器版本，不改变已固定的应用镜像版本。
# CANVAS_UPDATER_RELEASE_TAG=v1.2.9
# 自动配置后生成的 .env 仅作为更新/恢复元数据；仍以编排内的配置为准。
# CANVAS_UPDATER_CONFIG_SOURCE=compose
# Maximum full migration package size in bytes. The default is 20 GiB.
CANVAS_UPDATER_MIGRATION_MAX_BYTES=21474836480

# 不使用 systemd 时，可直接部署 docker-compose.container.yml；它会自动
# 拉起独立 host-updater 容器并在 named volume 中保存 Token/Socket。
# 默认要求宿主机项目目录为 /opt/open-ai-canvas；1Panel 使用其他目录时，
# 修改编排顶部 x-canvas-project-dir，而不是填写容器内路径。

# 新服务器请直接运行 README 的一键部署命令；脚本会在 .env 中生成以下 PostgreSQL 配置。
# POSTGRES_DB=open_ai_canvas
# POSTGRES_USER=open_ai_canvas
# POSTGRES_PASSWORD=由部署脚本随机生成
# DATABASE_URL=postgresql://open_ai_canvas:随机密码@postgres:5432/open_ai_canvas?sslmode=disable
# REDIS_URL=redis://redis:6379/0
# CANVAS_POSTGRES_DATA_PATH=./postgres-data
# CANVAS_REDIS_DATA_PATH=./redis-data
# CANVAS_HTTP_PORT=3000
# CANVAS_IMAGE_OWNER=buttonslaybaugh397-art
# CANVAS_IMAGE_TAG=latest
