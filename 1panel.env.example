# 1Panel compose environment. Do not put real credentials in this example file.
CANVAS_IMAGE_OWNER=buttonslaybaugh397-art
# Default: this fork's latest published images; optionally pin a published sha tag.
# A branch push alone does not publish images. Check the image workflow first.
# For a schema upgrade, pin the same published sha-<commit> tag for all app services.
CANVAS_IMAGE_TAG=latest

# Optional for same-origin access. For a separate browser origin, set e.g. https://canvas.example.com (no trailing slash).
CANVAS_CORS_ORIGINS=
# Default: access via the host reverse proxy with HTTPS.
# Direct IP testing: set 0.0.0.0 and an exact http://SERVER_IP:6868 origin.
CANVAS_BIND_ADDRESS=127.0.0.1
CANVAS_HTTP_PORT=6868

POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
# Empty: generate once for a new database, then reuse the secrets volume.
# Existing data: retain the matching secrets volume or provide the original password.
# A manually supplied password must be at least 32 letters/digits; no symbols.
POSTGRES_PASSWORD=

# Verify these are the OLD volume names before updating an existing deployment.
CANVAS_BACKEND_VOLUME=open-ai-canvas_backend-data
CANVAS_SECRETS_VOLUME=open-ai-canvas_deployment-secrets
CANVAS_POSTGRES_VOLUME=open-ai-canvas_postgres-data
CANVAS_REDIS_VOLUME=open-ai-canvas_redis-data

CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_SHUTDOWN_TIMEOUT=10m
