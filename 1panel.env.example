# Copy these variables into the 1Panel Compose environment editor.
POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://open_ai_canvas:replace_with_a_long_random_password@postgres:5432/open_ai_canvas?sslmode=disable

CANVAS_IMAGE_TAG=latest
CANVAS_HTTP_PORT=3000
CANVAS_CORS_ORIGINS=https://canvas.example.com
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
